{
  "name": "find-me-home",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build && node --experimental-strip-types scripts/build-pages-assets.ts",
    "start": "vite preview",
    "preview": "vite preview",
    "test": "vitest run --exclude=e2e/**",
    "test:e2e": "playwright test",
    "test:e2e:base-path": "E2E_BASE_PATH=/find-me-home/ playwright test",
    "test:e2e:termux": "FMH_TERMUX=1 NODE_OPTIONS=--require=./e2e/termux-preload.cjs PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=$(command -v chromium-browser) playwright test --workers=1",
    "deploy:worker": "wrangler deploy",
    "smoke:worker": "node --experimental-strip-types scripts/worker-smoke.ts",
    "smoke:pages": "node --experimental-strip-types scripts/pages-smoke.ts",
    "verify:worker-build": "node --experimental-strip-types scripts/verify-worker-build.ts",
    "generate:parcels": "node --experimental-strip-types scripts/generate-parcels.ts",
    "validate:parcels": "node --experimental-strip-types scripts/validate-parcels.ts",
    "typecheck": "tsc --noEmit",
    "typecheck:e2e": "tsc --project tsconfig.e2e.json --noEmit",
    "typecheck:e2e:termux": "tsc --project tsconfig.e2e.json --noEmit",
    "lint": "oxlint --deny-warnings --report-unused-disable-directives",
    "format": "oxfmt --write . && oxlint --fix",
    "check": "oxfmt --check ."
  },
  "dependencies": {
    "@solidjs/router": "2.0.0-next.24",
    "@solidjs/web": "2.0.0-rc.8",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/db": "^0.9.0",
    "@types/proj4": "^2.5.6",
    "leaflet": "^1.9.4",
    "proj4": "^2.20.9",
    "qrcode": "^1.5.4",
    "solid-js": "2.0.0-rc.8",
    "tailwindcss": "^4.1.18",
    "trystero": "^0.25.4",
    "valibot": "^1.4.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@solidjs/testing-library": "^0.8.10",
    "@solidjs/vite-plugin": "3.0.0-next.43",
    "@types/geojson": "^7946.0.16",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^26.4.1",
    "@types/qrcode": "^1.5.6",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.0.0",
    "oxfmt": "0.67.0",
    "oxlint": "1.82.0",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "^7.0.0",
    "vite": "^8.0.0",
    "vitest": "^5.0.0",
    "wrangler": "^4.35.0"
  },
  "packageManager": "pnpm@12.6.0+sha512.3ef68f951cb111ac204b4a5a16f0b2ddf0da56a96e0413e81d855d9f0b55ef926714709028e1cd00c405c2c5fb7b9e8ec4dc46777c805d0373c2f2ff00fd20ec"
}
